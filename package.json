{
  "name": "league-alert-oog",
  "productName": "League Alert OOG",
  "version": "1.0.0",
  "description": "Desktop reminders that fire the moment a League of Legends or Teamfight Tactics game ends.",
  "license": "MIT",
  "main": "src/main/main.js",
  "author": "kazu-source",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kazusource.leaguealertoog",
    "productName": "League Alert OOG",
    "copyright": "Copyright © 2026 kazu-source",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "League Alert OOG",
      "artifactName": "LeagueAlertOOG-Setup-${version}.${ext}",
      "uninstallDisplayName": "League Alert OOG ${version}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
